# ============================================
# メール自動化システム 環境変数設定
# ============================================

# ============================================
# 1. メール接続設定（以下から1つ選択）
# ============================================

# --- オプションA: IMAP/SMTP（一般的な方法）---
EMAIL_ADDRESS=your-email@example.com
EMAIL_PASSWORD=your-app-password
IMAP_SERVER=outlook.office365.com
IMAP_PORT=993
SMTP_SERVER=smtp.office365.com
SMTP_PORT=587
MAIL_PROCESSOR_TYPE=imap

# --- オプションB: Microsoft Graph API（推奨、より安全）---
# AZURE_CLIENT_ID=your-client-id
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_SECRET=your-client-secret
# AZURE_REDIRECT_URI=http://localhost:8080/callback
# EMAIL_ADDRESS=your-email@example.com
# MAIL_PROCESSOR_TYPE=graph

# --- オプションC: Exchange Web Services（IMAP無効でも動作）---
# EMAIL_ADDRESS=your-email@company.com
# EMAIL_PASSWORD=your-password
# EWS_SERVER=outlook.office365.com
# EWS_USE_NTLM=false
# MAIL_PROCESSOR_TYPE=ews

# --- オプションD: Outlook COM（Windows専用、推奨）---
# EMAIL_ADDRESS=your-email@company.com
# MAIL_PROCESSOR_TYPE=outlook_com

# ============================================
# 2. OpenAI API
# ============================================
OPENAI_API_KEY=your-openai-api-key

# ============================================
# 3. Slack通知（オプション）
# ============================================
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL=#monitoring

# ============================================
# 4. Google Drive（オプション）
# ============================================
GOOGLE_CREDENTIALS_FILE=credentials/google-credentials.json
GOOGLE_DRIVE_FOLDER_ID=your-folder-id

# ============================================
# 5. Obsidian連携
# ============================================
# Windowsの例: G:\path\to\vault
# macOSの例: /Users/username/Documents/ObsidianVault
OBSIDIAN_VAULT_PATH=path/to/your/vault

# Obsidian機能設定
OBSIDIAN_USE_TAGS=true
OBSIDIAN_USE_LINKS=true
OBSIDIAN_USE_FRONTMATTER=true
OBSIDIAN_CREATE_DAILY_INDEX=true
OBSIDIAN_CREATE_SENDER_INDEX=false

# プロジェクトキーワード（カンマ区切り）
PROJECT_KEYWORDS=プロジェクトA,プロジェクトB,重要案件

# ============================================
# 6. メール処理設定
# ============================================

# メール送信機能の有効/無効
ENABLE_EMAIL_SENDING=true

# メールを下書きに保存するか送信するか
SAVE_AS_DRAFT=true

# メール処理後の既読設定
# 0 = ルールベース（To/CC/名前で判定）
# 1 = 全部未読（推奨）
# 2 = 全部既読
MARK_AS_READ_AFTER_PROCESS=0

# ============================================
# 7. ルールベース判定用の設定（MARK_AS_READ_AFTER_PROCESS=0の場合）
# ============================================

# 自分の名前（本文/件名での判定用）
MY_NAME=山田

# 社内用の名前（返信テンプレート用）
MY_NAME_INTERNAL=山田（太郎）

# 会社名（返信テンプレート用）
MY_COMPANY_NAME=株式会社サンプル

# 社内ドメイン（カンマ区切り）
INTERNAL_DOMAINS=@example.com,@company.co.jp

# グループメールアドレス（カンマ区切り）
GROUP_EMAIL_ADDRESSES=team@example.com,project@example.com

# ============================================
# 8. 除外設定（すべてのモードで有効）
# ============================================

# 除外して未読維持（Teams通知など）
EXCLUDE_SENDER_DOMAINS=@teams.mail.microsoft,@noreply.github.com

# 除外して既読にする（セールスメールなど）
EXCLUDE_AND_READ_DOMAINS=@newsletter.example.com,sales@example.com

# ============================================
# 9. 返信テンプレート設定
# ============================================

# テンプレートファイルのパス
INTERNAL_EMAIL_TEMPLATE=templates/internal_template.txt
EXTERNAL_EMAIL_TEMPLATE=templates/external_template.txt

# ============================================
# 10. AI文体学習設定
# ============================================

# 文体学習を有効化
LEARN_WRITING_STYLE=true

# 学習するサンプル数
WRITING_STYLE_SAMPLE_COUNT=5

# ============================================
# 11. ログ設定
# ============================================

# ログレベル（DEBUG, INFO, WARNING, ERROR）
LOG_LEVEL=INFO

# ============================================
# 12. Outlookフォルダ除外設定（Outlook COM使用時）
# ============================================

# 除外するフォルダ名（カンマ区切り、部分一致）
OUTLOOK_EXCLUDE_FOLDERS=削除済みアイテム,ごみ箱,Archive

# 非メールフォルダを除外
OUTLOOK_EXCLUDE_CALENDAR=true
OUTLOOK_EXCLUDE_CONTACTS=true
OUTLOOK_EXCLUDE_TASKS=true
OUTLOOK_EXCLUDE_NOTES=true
OUTLOOK_EXCLUDE_JOURNAL=true

